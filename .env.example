# Copy to .env and fill in. Nothing here goes to the browser.

# Port of Studio on the server (default 8080); change it when 8080 is taken
STUDIO_PORT=8080

# Password for the Studio page (empty = no password; set it when the server is reachable from outside)
STUDIO_PASSWORD=

# Only without a password: names (besides IP addresses and localhost) Studio answers to, comma-separated,
# e.g. studio.home,tab5studio.lan. Other names are refused (protection against DNS rebinding).
ALLOWED_HOSTS=

# Built into every firmware: the Wi-Fi the Tab5 joins first and the PIN of its web page (4 digits)
WIFI_SSID=
WIFI_PASSWORD=
WEB_PIN=

# Live preview on the Tab5 (can also be set in Studio: Preview → Tab5 connection)
TAB5_HOST=
TAB5_PIN=
